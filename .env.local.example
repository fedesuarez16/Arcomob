# Copia este archivo a .env.local y completa los valores.
# .env.local está ignorado por git (.gitignore → .env*.local).

# Cuenta de Gmail desde la que se envían los mails (debe tener 2FA activado).
GMAIL_USER=tu-cuenta@gmail.com

# App Password de 16 caracteres generado en:
# https://myaccount.google.com/apppasswords
# (no es la contraseña normal de Gmail; requiere 2FA habilitado).
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Opcional: dirección que recibe los mails. Si lo dejás vacío, se envía a GMAIL_USER.
GMAIL_TO=braianesuarez@gmail.com
